generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categories_table {
  category_id   Int    @id @default(autoincrement())
  category_name String @unique @db.VarChar(100)
}



/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model employee {
  id     Int?
  name   String? @db.VarChar(50)
  salary Int?

  @@ignore
}



/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items_table {
  order_item_id Int      @id @default(autoincrement())
  order_id      Int
  product_id    Int
  quantity      Int
  price         Decimal  @db.Decimal(10, 2)
  subtotal      Decimal? @default(dbgenerated("((quantity)::numeric * price)")) @db.Decimal(10, 2)

  @@index([product_id], map: "idx_orderitems_table_product")
}





/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders_table {
  order_id     Int       @id @default(autoincrement())
  user_id      Int
  order_date   DateTime? @default(now()) @db.Timestamp(6)
  status       String?   @default("Pending") @db.VarChar(50)
  total_amount Decimal?  @default(0) @db.Decimal(10, 2)

  @@index([user_id], map: "idx_orders_table_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments_table {
  payment_id     Int       @id @default(autoincrement())
  order_id       Int
  payment_date   DateTime? @default(now()) @db.Timestamp(6)
  amount         Decimal   @db.Decimal(10, 2)
  payment_method String    @db.VarChar(50)
  payment_status String?   @default("Successful") @db.VarChar(50)

  @@index([order_id], map: "idx_payments_table_order")
}

/// This table has subclasses and requires additional setup for migrations. Visit https://pris.ly/d/table-inheritance for more info.
/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model person {
  id   Int?
  name String? @db.VarChar(50)

  @@ignore
}



/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products_table {
  product_id     Int       @id @default(autoincrement())
  category_id    Int
  name           String    @db.VarChar(150)
  description    String?
  price          Decimal   @db.Decimal(10, 2)
  stock_quantity Int
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  @@index([category_id], map: "idx_products_table_category")
}

model roles_table {
  role_id   Int    @id @default(autoincrement())
  role_name String @unique @db.VarChar(50)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model students {
  student_id Int?
  name       String? @db.VarChar(50)
  age        Int?

  @@ignore
}

model users_table {
  user_id       Int       @id @default(autoincrement())
  full_name     String    @db.VarChar(100)
  email         String    @unique(map: "idx_users_table_email_unique") @db.VarChar(100)
  password_hash String    @db.VarChar(255)
  address       String?
  role_id       Int
  created_at    DateTime? @default(now()) @db.Timestamp(6)

  @@index([email], map: "idx_users_table_email")
}
